# Copy to .env (never commit .env). Used by tools/cloudflare/upload-r2.mjs.
# Cloudflare dashboard → R2 → Manage API tokens → Create API token → "Object Read & Write" on your bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 → your bucket → Settings → "S3 API" (without the bucket name at the end)
R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
R2_BUCKET=quran-files
